@page "/military"
@* No @rendermode = Static SSR. Data is hardcoded — no API call, no interactivity needed. *@
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Top 10 Countries by Military Power</PageTitle>

<h2>
    Top 10 Countries by Military Power
    <span class="badge bg-secondary">Static SSR</span>
</h2>

<p class="text-muted">
    Rankings based on the <strong>Global Firepower Index (GFI) 2024</strong>.
    A lower Power Index score indicates greater military strength.
    Data is hardcoded (static page, no API call).
</p>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th style="width:60px">#</th>
                <th>Country</th>
                <th class="text-end">Active Personnel</th>
                <th class="text-end">Defense Budget</th>
                <th>Budget Share (of top 10)</th>
                <th class="text-end">GFI Score</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in MilitaryData)
            {
                var budgetSharePct = entry.BudgetBillions / TotalBudget * 100;
                var barWidth       = budgetSharePct.ToString("F0");
                var barLabel       = budgetSharePct.ToString("F1");
                <tr>
                    <td><strong>@entry.Rank</strong></td>
                    <td>
                        <span style="font-size:1.3rem" class="me-2">@entry.Flag</span>
                        @entry.Country
                    </td>
                    <td class="text-end font-monospace">@entry.PersonnelDisplay</td>
                    <td class="text-end font-monospace">$@entry.BudgetBillions.ToString("F0")B</td>
                    <td style="min-width:180px">
                        <div class="d-flex align-items-center gap-2">
                            <div class="progress flex-grow-1" style="height:10px">
                                <div class="progress-bar bg-danger"
                                     role="progressbar"
                                     aria-valuenow="@barWidth"
                                     aria-valuemin="0"
                                     aria-valuemax="100"
                                     aria-label="@entry.Country: @barLabel% of top-10 total defense budget"
                                     style="width:@barWidth%">
                                </div>
                            </div>
                            <small class="text-muted" style="min-width:40px">
                                @barLabel%
                            </small>
                        </div>
                    </td>
                    <td class="text-end font-monospace">@entry.GfiScore.ToString("F4")</td>
                </tr>
            }
        </tbody>
        <tfoot class="table-secondary">
            <tr>
                <td colspan="3"><strong>Top-10 Total Budget</strong></td>
                <td class="text-end font-monospace"><strong>$@TotalBudget.ToString("F0")B</strong></td>
                <td colspan="2"></td>
            </tr>
        </tfoot>
    </table>
</div>

<p class="text-muted small mt-2">
    Sources: Global Firepower Index 2024 (<a href="https://www.globalfirepower.com" target="_blank" rel="noopener">globalfirepower.com</a>);
    defense budgets from SIPRI / public estimates.
    GFI score: lower = stronger overall military capability.
</p>

@code {
    private record MilitaryEntry(
        int    Rank,
        string Flag,
        string Country,
        string PersonnelDisplay,
        double BudgetBillions,
        double GfiScore);

    // Global Firepower Index 2024 rankings with approximate personnel and budget figures
    private static readonly MilitaryEntry[] MilitaryData =
    [
        new(1,  "🇺🇸", "United States",   "1,390,000",  916.0, 0.0699),
        new(2,  "🇷🇺", "Russia",          "1,320,000",   86.4, 0.0702),
        new(3,  "🇨🇳", "China",           "2,035,000",  224.0, 0.0706),
        new(4,  "🇮🇳", "India",           "1,455,000",   81.4, 0.1023),
        new(5,  "🇰🇷", "South Korea",       "500,000",   46.4, 0.1416),
        new(6,  "🇬🇧", "United Kingdom",    "153,290",   75.0, 0.1443),
        new(7,  "🇯🇵", "Japan",             "247,150",   49.0, 0.1601),
        new(8,  "🇹🇷", "Turkey",            "355,200",   18.2, 0.1698),
        new(9,  "🇵🇰", "Pakistan",          "654,000",    7.6, 0.1711),
        new(10, "🇮🇹", "Italy",             "165,500",   32.0, 0.1863),
    ];

    // Sum of defense budgets across all top-10 entries — used as the bar denominator
    private static readonly double TotalBudget = MilitaryData.Sum(e => e.BudgetBillions);
}
