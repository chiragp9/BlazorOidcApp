@page "/auto-page"
@rendermode InteractiveAuto
@attribute [Authorize]

@inject IWeatherApiService WeatherApiService

<PageTitle>Auto Page</PageTitle>

<h2>
    Auto Page
    <span class="badge @(OperatingSystem.IsBrowser() ? "bg-success" : "bg-primary")">
        @(OperatingSystem.IsBrowser() ? "WebAssembly" : "Server") Interactive
    </span>
</h2>

<p class="text-muted">
    This page uses <code>InteractiveAuto</code> render mode. On the <strong>first visit</strong>,
    Blazor runs it as <strong>Interactive Server</strong> (instant startup — no WASM download needed).
    Once the WebAssembly bundle is downloaded and cached, <strong>subsequent visits</strong> switch
    to <strong>Interactive WebAssembly</strong>, dropping the SignalR connection entirely.
</p>

<div class="alert alert-info">
    <strong>Current runtime:</strong>
    @if (OperatingSystem.IsBrowser())
    {
        <span>
            Running in <strong>WebAssembly</strong> (WASM bundle cached).
            Token obtained via <code>/bff/token</code> by <code>WasmWeatherApiService</code>.
        </span>
    }
    else
    {
        <span>
            Running on the <strong>server</strong> via SignalR (first visit or WASM not yet cached).
            Token attached automatically by <code>BearerTokenHandler</code> in <code>ServerWeatherApiService</code>.
        </span>
    }
</div>

<button class="btn btn-warning" @onclick="LoadWeather" disabled="@isLoading">
    @(isLoading ? "Loading..." : "Fetch Weather")
</button>

@if (forecasts is not null)
{
    <table class="table table-striped mt-3">
        <thead>
            <tr><th>Date</th><th>Temp (°C)</th><th>Temp (°F)</th><th>Summary</th></tr>
        </thead>
        <tbody>
            @foreach (var f in forecasts)
            {
                <tr>
                    <td>@f.Date.ToShortDateString()</td>
                    <td>@f.TemperatureC</td>
                    <td>@f.TemperatureF</td>
                    <td>@f.Summary</td>
                </tr>
            }
        </tbody>
    </table>
}

@if (errorMessage is not null)
{
    <div class="alert alert-danger mt-3">
        @errorMessage
        @if (isUnauthorized)
        {
            <a href="auth/login" class="btn btn-warning ms-2 btn-sm">Login again</a>
        }
    </div>
}

@code {
    private WeatherForecast[]? forecasts;
    private string? errorMessage;
    private bool isLoading;
    private bool isUnauthorized;

    private async Task LoadWeather()
    {
        isLoading      = true;
        errorMessage   = null;
        isUnauthorized = false;
        forecasts      = null;

        try
        {
            forecasts = await WeatherApiService.GetWeatherAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage   = ex.Message;
            isUnauthorized = true;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
